@@ -286,9 +286,30 @@ void QtUi::setupIconTheme()
     themePaths << ":/icons";
     QIcon::setThemeSearchPaths(themePaths);
 
+    // Watch for the system switching between light and dark appearance
+    _darkPalette = isDarkPalette();
+    qApp->installEventFilter(this);
+
     refreshIconTheme();
 }
 
+bool QtUi::isDarkPalette() const
+{
+    return QApplication::palette().color(QPalette::Window).lightness() < 128;
+}
+
+bool QtUi::eventFilter(QObject* obj, QEvent* event)
+{
+    if (obj == qApp && event->type() == QEvent::ApplicationPaletteChange) {
+        bool dark = isDarkPalette();
+        if (dark != _darkPalette) {
+            _darkPalette = dark;
+            refreshIconTheme();
+        }
+    }
+    return GraphicalUi::eventFilter(obj, event);
+}
+
 void QtUi::refreshIconTheme()
 {
     // List of available fallback themes
@@ -313,6 +334,10 @@ void QtUi::refreshIconTheme()
         if (availableThemes.contains(_systemIconTheme)) {
             fallbackTheme = _systemIconTheme;
         }
+        else if (isDarkPalette() && availableThemes.contains("breeze-dark")) {
+            // No usable system theme (e.g. on macOS), so match the light/dark appearance
+            fallbackTheme = "breeze-dark";
+        }
         else {
             fallbackTheme = availableThemes.first();
         }
